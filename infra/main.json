            "accountId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Storage/storageAccounts', parameters('accountName'))]"
            },
            "connectionString": {
              "type": "securestring",
              "metadata": {
                "description": "Primary blob storage connection string (sensitive)"
              },
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix={2}', parameters('accountName'), listKeys('storageAccount', '2023-05-01').keys[0].value, environment().suffixes.storage)]"
            }
          }
        }
      }
